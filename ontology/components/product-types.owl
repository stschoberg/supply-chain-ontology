    <!-- https://w3id.org/sco/Bearing -->

    <owl:Class rdf:about="https://w3id.org/sco/Bearing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sco/Product"/>
        <rdfs:label>bearing</rdfs:label>
        <skos:definition>A product that constrains relative motion between moving parts and reduces friction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/sco/Magnet -->

    <owl:Class rdf:about="https://w3id.org/sco/Magnet">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sco/Product"/>
        <rdfs:label>magnet</rdfs:label>
        <skos:definition>A product that produces a persistent magnetic field.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/sco/Product -->

    <owl:Class rdf:about="https://w3id.org/sco/Product"/>
    


    <!-- https://w3id.org/sco/RareEarthOxide -->

    <owl:Class rdf:about="https://w3id.org/sco/RareEarthOxide">
        <rdfs:subClassOf rdf:resource="https://w3id.org/sco/Product"/>
        <rdfs:label>rare earth oxide</rdfs:label>
        <skos:definition>A product consisting of an oxide of one or more rare earth elements, used as feedstock for magnets and other components.</skos:definition>
    </owl:Class>
