@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix sco:  <https://w3id.org/sco/> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shp:  <https://w3id.org/sco/shapes/> .

# SHACL shapes are closed-world data-quality checks: "this record is incomplete".
# OWL can't express these, because under the open-world assumption missing data is just unknown.

shp:SupplyProcessShape a sh:NodeShape ;
    sh:targetClass sco:SupplyProcess ;
    sh:property [
        sh:path obo:BFO_0000057 ;  # has participant
        sh:qualifiedValueShape [ sh:class sco:Product ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A supply process must have at least one product participant." ;
    ] ;
    sh:property [
        sh:path obo:BFO_0000057 ;
        sh:qualifiedValueShape [ sh:class sco:Organization ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A supply process must have at least one organization participant." ;
    ] .

shp:LabelledShape a sh:NodeShape ;
    sh:targetClass sco:Organization , sco:Product ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Organizations and products must have a label." ;
    ] .
